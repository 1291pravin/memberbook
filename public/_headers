# Cloudflare Workers static assets: browser caching for files in public/.
# (Hashed /_nuxt/ files already get a one-year immutable cache.)
# These names are not hashed, so keep the cache to a week: a replaced file
# reaches everyone within days, and repeat visitors stop re-downloading
# the 3 MB homepage video on every visit.
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/blog/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/logo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/android-chrome-*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
