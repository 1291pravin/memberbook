{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memberbook",
  "compatibility_date": "2025-07-15",
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memberbook-db-prd",
      "database_id": "7b694b50-7cbb-4f81-989c-c28ab4884f02",
      "migrations_table": "d1_migrations",
      "migrations_dir": "server/db/migrations/sqlite",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "memberbook-blob",
    },
  ],
  // Email alerts for new WhatsApp inbox messages (server/utils/inbox-alert.ts).
  // Sends only to verified Cloudflare Email Routing destination addresses.
  "send_email": [
    {
      "name": "ALERT_EMAIL",
    },
  ],
  // Daily fee reminders and the admin digest email at 09:00 IST, plus the hourly
  // zero-token check for waiting AI work (see nitro.scheduledTasks in nuxt.config.ts).
  "triggers": {
    "crons": ["30 3 * * *", "41 * * * *"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "vars": {
    // MemberBook's own UPI ID for add-on bills (not secret: payers see it).
    "NUXT_BILLING_UPI_ID": "1291pravin@okhdfcbank",
    "NUXT_PUBLIC_APP_URL": "https://memberbook.in",
    "NUXT_SITE_URL": "https://memberbook.in",
    "NUXT_SITE_NAME": "MemberBook",
    "NUXT_PUBLIC_GTAG_ID": "G-0X02PJLVRK",
    // Support number is connected to the WhatsApp Cloud API, so show WhatsApp contact links.
    "NUXT_PUBLIC_SUPPORT_WHATSAPP_LIVE": "true",
    // Not secret: Meta WhatsApp Business Account and app ids (webhook link + profile photo upload).
    "NUXT_WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID": "1686210686459455",
    "NUXT_WHATSAPP_CLOUD_APP_ID": "2076715572848640",
    // Automatic fee reminders from the MemberBook number (Pravin approved 2026-11-13).
    // Each business still has to opt in on Collections > Payment settings.
    "NUXT_WHATSAPP_CLOUD_ENABLED": "true",
    // Not secret: "Connect with WhatsApp" (embedded signup) app id. The config id
    // comes from Facebook Login for Business > Configurations in the Meta app.
    "NUXT_PUBLIC_WHATSAPP_SIGNUP_APP_ID": "2076715572848640",
    // Facebook Login for Business > Configurations > "MemberBook WhatsApp signup".
    "NUXT_PUBLIC_WHATSAPP_SIGNUP_CONFIG_ID": "2724637357966286",
  },
}
